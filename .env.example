# Front (Vite). Copiar a `.env` — estas variables SÍ terminan en el bundle del cliente.
# Ver la nota de seguridad sobre VITE_APP_TOKEN en el README.

# Origen del Worker desplegado. Vacío en desarrollo: Vite proxea /api a :8787.
VITE_API_BASE=

# Token compartido que el Worker exige en la cabecera X-App-Token.
# Debe coincidir con el secret APP_TOKEN del Worker.
VITE_APP_TOKEN=
